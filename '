fn lex(tokens: Vec<Token>) {
    println!("Token count: {}", tokens.len());
    for token in tokens {
        println!("Token: {:?}", token);
    }
}

fn main() {
    let mut debug = false;
    let args: Vec<String> = env::args().collect();
    let mut source_files: Vec<SourceFile> = Vec::new();

    if args.len() < 2 {
        println!("Usage: zinc <file>");
        return;
    }

    for arg in args.iter().skip(1) {
        match arg.as_str() {
            "-h" | "--help" => {
                println!("Usage: zinc <file>");
                return;
            }
            "-d" | "--debug" => {
                debug = true;
            }
            "-v" | "--version" => {
                println!("zinc-compiler v{}", env!("CARGO_PKG_VERSION"));
                return;
            }
            _ => {
                let mut file = File::open(arg).unwrap();
                let mut contents = String::new();
                file.read_to_string(&mut contents).unwrap();
                source_files.push(SourceFile::new(arg.to_string(), contents));
            }
        }
    }

    let tokens: Vec<Token> = parse(&source_files[0]);
    lex(tokens);
}
