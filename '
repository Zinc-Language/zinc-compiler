#[derive(Debug)]
enum TOKEN_TYPE {
    Tok_If,
    Tok_Else,
    Tok_Let,
    Tok_Return,
    Tok_Plus,
    Tok_Minus,
    Tok_Times,
    Tok_Divide,
    Tok_Number,
    Tok_Float,
    Tok_Bracket,
    Tok_Brace,
    Tok_Semi,
    Tok_Unknown,
}

#[derive(Debug)]
struct Token {
    tok_type: TOKEN_TYPE,
    tok_value: String,
}

struct SourceFile {
    name: String,
    source: String,
    source_len: usize,
    index: usize,
}

impl SourceFile {
    pub fn new(file_name: String, source_code: String) -> SourceFile {
        SourceFile {
            name: file_name,
            source: source_code.clone(),
            source_len: source_code.len(),
            index: 0,
        }
    }

    pub fn peek(&self, ahead: usize) -> Option<char> {
        self.source.chars().nth(self.index + ahead)
    }

    pub fn consume(&mut self, amount: usize) -> bool {
        if self.index + amount < self.source_len {
            self.index += amount;
            true
        } else {
            false
        }
    }
}

fn get_token_type(tok_buf: String) -> TOKEN_TYPE {
    let token_type: TOKEN_TYPE = match tok_buf.as_str() {
        "return" => TOKEN_TYPE::Tok_Return,
        _ => {
            // Check if the token is a number
            if tok_buf.chars().all(|c| c.is_digit(10)) {
                TOKEN_TYPE::Tok_Number
            } else {
                TOKEN_TYPE::Tok_Unknown
            }
        }
    };

    token_type
}

