fn parse(mut src: SourceFile) -> Vec<Token> {
    let mut tokens: Vec<Token> = Vec::new();

    while src.consume(1) {
        let mut tok_buf = String::new();
        let oc = src.peek(0);

        let c: char = match oc {
            Some(c) => c,
            None => '\0',
        };

        // end of file or improper read of character condition
        if c == '\0' {
            return tokens;
        }

        if c != ' ' || c != '\n' {
            tok_buf.push(c);
        } else {
            let mut token = Token {
                tok_type: TOKEN_TYPE::Tok_Unknown,
